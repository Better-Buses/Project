NAME = "Ubuntu Minimal 24.04 - Master"

HYPERVISOR = "kvm"
LOGO = "images/logos/ubuntu.png"
LXD_SECURITY_PRIVILEGED = "true"
SCHED_REQUIREMENTS = "HYPERVISOR=kvm"

CPU = "1"
VCPU = "1"
MEMORY = "4096"

CPU_MODEL = [
  MODEL = "host-model"
]

DISK = [
  IMAGE_ID = "1",
  SIZE = "15360"
]

NIC = [
  NETWORK = "vnet",
  SECURITY_GROUPS = "${MASTER_SG_ID}"
]

NIC_DEFAULT = [
  MODEL = "virtio"
]

GRAPHICS = [
  LISTEN = "0.0.0.0",
  TYPE = "vnc"
]

CONTEXT = [
  NETWORK = "YES",
  SSH_PUBLIC_KEY = "$USER[SSH_PUBLIC_KEY]",
  START_SCRIPT_BASE64 = "${START_SCRIPT_B64}"
]

OS = [
  ARCH = "x86_64"
]