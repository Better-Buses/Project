NAME = "Alpine Linux 3.20 - OurSensors"

HYPERVISOR = "kvm"
LOGO = "images/logos/linux.png"
LXD_SECURITY_PRIVILEGED = "true"
SCHED_REQUIREMENTS = "HYPERVISOR=kvm"

CPU = "1"
VCPU = "1"
MEMORY = "256"

DISK = [
  IMAGE_ID = "0"
]

NIC = [
  NETWORK = "vnet",
  SECURITY_GROUPS = "0"
]

NIC_DEFAULT = [
  MODEL = "virtio"
]

GRAPHICS = [
  LISTEN = "0.0.0.0",
  TYPE = "vnc"
]

CONTEXT = [
  NETWORK = "YES",
  REPORT_READY = "NO",
  SSH_PUBLIC_KEY = "$USER[SSH_PUBLIC_KEY]",
  START_SCRIPT_BASE64 = "",
  TOKEN = "NO"
]

OS = [
  ARCH = "x86_64"
]